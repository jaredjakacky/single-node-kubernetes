{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/containerd\\/defaults\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\ncontainerd_(?:runc_)?version: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/kubernetes\\/defaults\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\nkubernetes_version: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/cilium\\/vars\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\ncilium_helm_version: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/cilium\\/vars\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) versioning=(?<versioning>\\S+)\\ncilium_supported_chart_version: \"(?<currentValue>[^\"]+)\"\\ncilium_chart_oci_repository: oci://(?<depName>\\S+)\\ncilium_chart_digest: >-\\n  (?<currentDigest>sha256:[0-9a-f]{64})"
      ]
    },
    {
      "customType": "regex",
      "description": "Track the upstream CNI plugins version embedded in the Debian package fixture",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/ansible-ci\\.yaml$/"
      ],
      "matchStrings": [
        "package_version=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)-[^\"\\s]+\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "containernetworking/plugins",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the tag and digest for the Kubernetes agnhost validation image",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/cilium\\/vars\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\ncilium_validation_image: >-\\n  \\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep containerd on the selected 2.3 LTS release line",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["containerd/containerd"],
      "allowedVersions": "/^v?2\\.3\\./"
    },
    {
      "description": "Track supported stable runc 1.x releases",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["opencontainers/runc"],
      "allowedVersions": "/^v?1\\./",
      "ignoreUnstable": true
    },
    {
      "description": "Keep Kubernetes on stable 1.36 patch releases",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["kubernetes/kubernetes"],
      "allowedVersions": "/^v?1\\.36\\./",
      "ignoreUnstable": true
    },
    {
      "description": "Keep Helm on stable 4.x releases",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["helm/helm"],
      "allowedVersions": "/^v?4\\./",
      "ignoreUnstable": true
    },
    {
      "description": "Keep Cilium on the selected stable 1.20 release line",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/cilium/charts/cilium"],
      "allowedVersions": "/^v?1\\.20\\./",
      "ignoreUnstable": true
    },
    {
      "description": "Keep CNI plugins aligned with Kubernetes 1.36's package baseline",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["containernetworking/plugins"],
      "allowedVersions": "/^v?1\\.9\\./",
      "ignoreUnstable": true,
      "prBodyNotes": [
        "The Debian package revision and SHA-256 in `.github/workflows/ansible-ci.yaml` are manual review gates. Update both from `pkgs.k8s.io` before merging."
      ]
    },
    {
      "description": "Keep agnhost aligned with Kubernetes 1.36's e2e dependency",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.k8s.io/e2e-test-images/agnhost"],
      "allowedVersions": "/^2\\.63\\./",
      "ignoreUnstable": true,
      "prBodyNotes": [
        "Verify the proposed tag against Kubernetes 1.36's `build/dependencies.yaml` before merging."
      ]
    }
  ]
}
