{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/containerd\\/defaults\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\ncontainerd_(?:runc_)?version: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/kubernetes\\/defaults\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\nkubernetes_version: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/cilium\\/vars\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\ncilium_helm_version: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible\\/roles\\/cilium\\/vars\\/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) versioning=(?<versioning>\\S+)\\ncilium_supported_chart_version: \"(?<currentValue>[^\"]+)\"\\ncilium_chart_oci_repository: oci://(?<depName>\\S+)\\ncilium_chart_digest: >-\\n  (?<currentDigest>sha256:[0-9a-f]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep containerd on the selected 2.3 LTS release line",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["containerd/containerd"],
      "allowedVersions": "/^v?2\\.3\\./"
    },
    {
      "description": "Track supported stable runc 1.x releases",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["opencontainers/runc"],
      "allowedVersions": "/^v?1\\./",
      "ignoreUnstable": true
    },
    {
      "description": "Keep Kubernetes on stable 1.36 patch releases",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["kubernetes/kubernetes"],
      "allowedVersions": "/^v?1\\.36\\./",
      "ignoreUnstable": true
    },
    {
      "description": "Keep Helm on stable 4.x releases",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["helm/helm"],
      "allowedVersions": "/^v?4\\./",
      "ignoreUnstable": true
    },
    {
      "description": "Keep Cilium on the selected stable 1.20 release line",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/cilium/charts/cilium"],
      "allowedVersions": "/^v?1\\.20\\./",
      "ignoreUnstable": true
    }
  ]
}
