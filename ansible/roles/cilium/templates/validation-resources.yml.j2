---
apiVersion: v1
kind: Pod
metadata:
  name: cilium-validation-server
  labels:
    app.kubernetes.io/name: cilium-validation-server
spec:
  restartPolicy: Never
  terminationGracePeriodSeconds: 0
  containers:
    - name: server
      image: {{ cilium_validation_image | to_json }}
      imagePullPolicy: IfNotPresent
      command:
        - /agnhost
        - netexec
        - --http-port=8080
      ports:
        - name: http
          containerPort: 8080
          protocol: TCP
      readinessProbe:
        httpGet:
          path: /hostname
          port: http
        initialDelaySeconds: 1
        periodSeconds: 1
        timeoutSeconds: 1
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 100m
          memory: 64Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
---
apiVersion: v1
kind: Pod
metadata:
  name: cilium-validation-client-allowed
  labels:
    app.kubernetes.io/name: cilium-validation-client
    cilium-validation-access: allowed
spec:
  restartPolicy: Never
  terminationGracePeriodSeconds: 0
  containers:
    - name: client
      image: {{ cilium_validation_image | to_json }}
      imagePullPolicy: IfNotPresent
      command:
        - /agnhost
        - pause
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 100m
          memory: 64Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
---
apiVersion: v1
kind: Pod
metadata:
  name: cilium-validation-client-denied
  labels:
    app.kubernetes.io/name: cilium-validation-client
    cilium-validation-access: denied
spec:
  restartPolicy: Never
  terminationGracePeriodSeconds: 0
  containers:
    - name: client
      image: {{ cilium_validation_image | to_json }}
      imagePullPolicy: IfNotPresent
      command:
        - /agnhost
        - pause
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 100m
          memory: 64Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        readOnlyRootFilesystem: true
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
---
apiVersion: v1
kind: Service
metadata:
  name: cilium-validation-server
spec:
  selector:
    app.kubernetes.io/name: cilium-validation-server
  ports:
    - name: http
      port: 8080
      protocol: TCP
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: cilium-validation-server-ingress
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: cilium-validation-server
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              cilium-validation-access: allowed
      ports:
        - port: 8080
          protocol: TCP
